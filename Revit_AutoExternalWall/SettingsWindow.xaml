<Window x:Class="Revit_AutoExternalWall.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки AutoExternalWall" Height="450" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="Настройки плагина AutoExternalWall" 
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
        
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <CheckBox x:Name="chkCreateOpenings" 
                      Content="Создавать проемы в внешних стенах (для окон и дверей)"
                      IsChecked="True"
                      Margin="0,5"/>
            <TextBlock Text="Когда включено, проемы будут автоматически создаваться во внешних стенах на основе окон и дверей из внутренних стен."
                       TextWrapping="Wrap"
                       Margin="20,5,0,0"
                       Foreground="Gray"
                       FontSize="11"/>
            
            <CheckBox x:Name="chkCopyOpenings" 
                      Content="Копировать окна и двери во внешние стены"
                      IsChecked="False"
                      Margin="0,15,0,5"/>
            <TextBlock Text="Когда включено, окна и двери из внутренних стен будут копироваться во внешние стены в тех же местах."
                       TextWrapping="Wrap"
                       Margin="20,5,0,0"
                       Foreground="Gray"
                       FontSize="11"/>
            
            <TextBlock Text="Тип стены для внешних стен:"
                       Margin="0,20,0,5"
                       FontWeight="SemiBold"/>
            <ComboBox x:Name="cmbWallType"
                      Margin="0,0,0,5"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"/>
            <TextBlock Text="Выберите тип стены, который будет использоваться для создания внешних стен."
                       TextWrapping="Wrap"
                       Margin="0,0,0,0"
                       Foreground="Gray"
                       FontSize="11"/>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="75" Height="25" Margin="5,0" Click="BtnOk_Click"/>
            <Button Content="Отмена" Width="75" Height="25" Margin="5,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>

